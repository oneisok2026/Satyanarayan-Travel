# ============================================================
# Satyanarayan Travel — Environment Configuration
# Copy to `.env.local` for development. Never commit real values.
# ============================================================

# ---- Application ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Satyanarayan Tour & Travel PVT. LTD."
NODE_ENV=development

# ---- Firebase Web SDK (client-safe, sent to the browser) ----
# Firebase Console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" only after enabling the Google provider in Firebase Console.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# ---- Firebase Admin SDK (SERVER ONLY — never prefix with NEXT_PUBLIC_) ----
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole key in double quotes, keeping the literal \n escapes.
FIREBASE_PRIVATE_KEY=""

# ---- MongoDB Atlas (SERVER ONLY) ----
MONGODB_URI=
MONGODB_DB_NAME=satyanarayan_travel

# ---- Session ----
SESSION_COOKIE_NAME=__session
# Session cookie lifetime in days (Firebase allows 1–14).
SESSION_COOKIE_DAYS=5

# ---- Email notifications (optional; unset = notifications no-op safely) ----
# Supported: "resend" | "smtp" | "" (disabled)
EMAIL_PROVIDER=
EMAIL_FROM="Satyanarayan Tour & Travel PVT. LTD. <noreply@example.com>"
EMAIL_ADMIN_RECIPIENTS=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- Agency contact details (public, shown in UI) ----
NEXT_PUBLIC_CONTACT_PHONE=+911234567890
NEXT_PUBLIC_WHATSAPP_NUMBER=911234567890
NEXT_PUBLIC_CONTACT_EMAIL=info@example.com

# ---- Seeding ----
# Firebase UID promoted to super_admin by `npm run seed`.
SEED_SUPER_ADMIN_UID=
SEED_SUPER_ADMIN_EMAIL=
